# Shared login for THF slot members. One username and password for the group.
MEMBER_USERNAME=member
MEMBER_PASSWORD=replace-with-a-long-password

# Signs the session cookie. Use a long random string (32+ characters).
# Render can generate this for you (see render.yaml).
SESSION_SECRET=replace-with-a-long-random-string

# Digital sign-up form. Leave empty to show "Link coming soon" instead of the button.
# If this variable is unset, the site uses the default below.
SIGNUP_URL=https://ultimate-driver-form.onrender.com

# Render sets PORT. Local default is 3000.
PORT=3000

# Set to production on Render so the session cookie is marked Secure (HTTPS).
# Leave as development for local http://localhost.
NODE_ENV=development
